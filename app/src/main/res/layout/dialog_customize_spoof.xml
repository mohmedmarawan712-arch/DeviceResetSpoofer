<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/dlg_app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dlg_app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Customize Spoof Items"/>

            <TextView
                android:id="@+id/dlg_app_pkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="com.package.name"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/dlg_btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/cancel"/>
    </LinearLayout>

    <!-- Quick Preset Buttons Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preset_all"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/select_all"
                android:textSize="11sp"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preset_none"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/deselect_all"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preset_recommended"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/preset_recommended"
                android:textSize="11sp"
                android:textColor="@color/accent_green"
                app:strokeColor="@color/accent_green"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preset_ids"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/preset_ids_only"
                android:textSize="11sp"
                android:textColor="@color/secondary"
                app:strokeColor="@color/secondary"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Items Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/dlg_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Items will be populated or inflated here -->

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlg_btn_random_selected"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/randomize_selected"
            android:textColor="@color/primary"
            android:textSize="13sp"
            app:icon="@drawable/ic_shuffle"
            app:iconTint="@color/primary"
            app:iconGravity="textStart"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.2dp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlg_btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/save_and_apply"
            android:textColor="@color/background"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/background"
            app:iconGravity="textStart"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>
