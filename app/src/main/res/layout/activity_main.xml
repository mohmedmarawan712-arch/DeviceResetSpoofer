<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- NestedScrollView containing the entire fluid UI -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp">

            <!-- Ultra-Modern Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <!-- Brand Monogram Capsule -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_squircle_icon"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/primary"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DeviceReset Spoofer"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xposed Identity Virtualizer"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Header Actions -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_action_settings"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Settings"/>

                    <ImageButton
                        android:id="@+id/btn_action_language"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_language"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Language"/>

                    <ImageButton
                        android:id="@+id/btn_action_about"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_secondary"
                        android:contentDescription="About"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Heads-Up Display (HUD) Dashboard Card -->
            <LinearLayout
                android:id="@+id/card_framework_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hud_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <!-- Status Header: Dot + FW Name + Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/view_fw_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_dot"
                        android:layout_marginEnd="10dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_fw_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LSPosed Framework"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_fw_scope_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connected • Scope Ready"
                            android:textColor="@color/accent_green"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Integrated Live Verification Pill Badge -->
                    <LinearLayout
                        android:id="@+id/badge_live_status"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_pill_green"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/iv_live_status_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/accent_green"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Status"/>

                        <TextView
                            android:id="@+id/tv_live_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نشط تلقائياً"
                            android:textSize="11sp"
                            android:textColor="@color/accent_green"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Metrics 3-Column Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_stat_targets_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:text="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:text="التطبيقات"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_stat_active_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_green"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:text="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:text="المعايير المزيّفة"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="LSPosed"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:text="الحالة"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Fast Random All Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_random_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/randomize_all"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_shuffle"
                    app:iconSize="14dp"
                    app:iconTint="@color/primary"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <!-- Segmented Top Switcher (Replacing Bottom Navigation Bar) -->
            <LinearLayout
                android:id="@+id/container_segmented_hub"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_segmented_hub"
                android:orientation="horizontal"
                android:padding="3dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tab_hub_apps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_selected"
                    android:text="@string/tab_apps"
                    android:textColor="@color/background"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tab_hub_engine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_unselected"
                    android:text="@string/tab_engine"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tab_hub_logs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_unselected"
                    android:text="@string/tab_logs"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Page 1: Target Apps Content -->
            <LinearLayout
                android:id="@+id/page_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Search Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_search_box"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_tertiary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/search_hint"/>

                    <EditText
                        android:id="@+id/et_search_apps"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:textColorHint="@color/text_tertiary"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"/>

                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_tertiary"
                        android:visibility="gone"
                        android:contentDescription="Clear"/>
                </LinearLayout>

                <!-- RecyclerView for Target Apps -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_target_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="36dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/primary"
                        android:contentDescription="@string/app_name"/>

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp"
                        android:text="@string/empty_apps_title"/>

                    <TextView
                        android:id="@+id/tv_empty_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="@string/empty_apps_desc"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_empty_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_app"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/background"
                        app:iconGravity="textStart"
                        android:layout_marginTop="16dp"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Page 2: Global Engine Content -->
            <LinearLayout
                android:id="@+id/page_engine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_engine_switches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Page 3: Logs Content -->
            <LinearLayout
                android:id="@+id/page_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Diagnostic Summary Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_log_stat_system"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نشط"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="محرك النظام"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_log_stat_targets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 تطبيق"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تطبيقات النظام"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_box"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_log_stat_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="خفي (System)"
                            android:textColor="@color/secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نمط النطاق"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tv_logs_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="سجلات الفحص والتشخيص"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_spoof"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اختبار"
                        android:textColor="@color/accent_green"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_logs"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح"
                        android:textColor="@color/accent_red"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_logs"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تصدير"
                        android:textColor="@color/primary"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_logs_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="monospace"/>
                    </ScrollView>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Pill Dock for adding apps -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/add_app"
        android:textColor="@color/background"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/background"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
