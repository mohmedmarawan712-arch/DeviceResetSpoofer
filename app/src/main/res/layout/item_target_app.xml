<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon + Titles + Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="App Name"/>

                <TextView
                    android:id="@+id/tv_app_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"
                    android:text="com.example.app"/>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_spoof_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <!-- Status & Active Chips Row -->
        <LinearLayout
            android:id="@+id/layout_tags_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <!-- Scope status pill badge -->
            <LinearLayout
                android:id="@+id/container_scope_badge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_pill_green"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="8dp">

                <View
                    android:id="@+id/view_scope_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/status_dot"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_scope_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:text="LSPosed OK"/>
            </LinearLayout>

            <!-- Spoofed items summary badge -->
            <TextView
                android:id="@+id/tv_active_items_summary"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:singleLine="true"
                android:text="11/11 Active"/>
        </LinearLayout>

        <!-- Subtle Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"/>

        <!-- Action Buttons Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Customize Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_customize_items"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/customize_spoof"
                android:textSize="12sp"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_tune"
                app:iconTint="@color/primary"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.2dp"
                app:cornerRadius="12dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_marginEnd="6dp"/>

            <!-- Randomize Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_random"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_shuffle"
                app:iconTint="@color/primary"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:contentDescription="@string/randomize_selected"
                android:layout_marginEnd="6dp"/>

            <!-- Launch App Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_launch_app"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_launch"
                app:iconTint="@color/secondary"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:contentDescription="@string/launch_app"
                android:layout_marginEnd="6dp"/>

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_app"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/accent_red"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:contentDescription="@string/remove_target"
                android:layout_marginEnd="6dp"/>

            <!-- More Options Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_more_menu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_more"
                app:iconTint="@color/text_secondary"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:contentDescription="Options"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
